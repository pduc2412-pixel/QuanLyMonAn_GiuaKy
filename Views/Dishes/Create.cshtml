@model Dish_BIT240069
@{
    ViewData["Title"] = L["title_create_dish"];
}
<h2 class="mb-3">@L["title_create_dish"]</h2>
<form method="post" asp-action="Create" class="card card-body" novalidate>
    <partial name="_DishFields" model="Model" />
    <div>
        <button type="submit" class="btn btn-primary">@L["btn_create"]</button>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["btn_cancel"]</a>
    </div>
</form>
