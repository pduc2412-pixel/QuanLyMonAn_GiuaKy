@{
    var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
}
<!DOCTYPE html>
<html lang="@L.Current">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? L["app_title"]) - @L["app_title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Dishes" asp-action="Index">@L["app_title"]</a>
        <ul class="navbar-nav me-auto">
            <li class="nav-item"><a class="nav-link" asp-controller="Dishes" asp-action="Index">@L["nav_dishes"]</a></li>
            <li class="nav-item"><a class="nav-link" asp-controller="DishCategories" asp-action="Index">@L["nav_categories"]</a></li>
        </ul>
        <div class="btn-group btn-group-sm">
            <a class="btn @(L.Current == "en" ? "btn-light" : "btn-outline-light")"
               asp-controller="Home" asp-action="SetLanguage" asp-route-lang="en" asp-route-returnUrl="@returnUrl"><img src="/img/flag-gb.svg" alt="" width="20" height="14" class="me-1 align-text-bottom border" /> @L["lang_en"]</a>
            <a class="btn @(L.Current == "vi" ? "btn-light" : "btn-outline-light")"
               asp-controller="Home" asp-action="SetLanguage" asp-route-lang="vi" asp-route-returnUrl="@returnUrl"><img src="/img/flag-vn.svg" alt="" width="20" height="14" class="me-1 align-text-bottom border" /> @L["lang_vi"]</a>
        </div>
    </div>
</nav>

<main class="container pb-5">
    @if (!string.IsNullOrEmpty(success))
    {
        <div class="alert alert-success">@L[success]</div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@L[error]</div>
    }
    @RenderBody()
</main>

<footer class="text-center text-muted small pb-4">@L["footer"]</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
